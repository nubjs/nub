#!/bin/sh
# pre-push hook: build site/ before a push that touches it.
#
# WHY THIS EXISTS: nothing else gates the marketing site before it deploys.
# ci.yml triggers only on `push: main` and `pull_request: main`, but most work
# here lands on long-lived feature branches pushed directly — so on those,
# Vercel is the FIRST thing that ever type checks site/, and it reports by email
# after the fact. That is how a type error in src/app/api/search/route.ts broke
# ~34 consecutive preview deployments across three days (2026-07-28..31) with a
# fix sitting unmerged on a branch the whole time.
#
# Runs the SAME `next build` Vercel runs, so this gate cannot drift from the
# thing it is protecting. ~20s, and only when the pushed commits touch site/**;
# a Rust-only push never pays for it. For the inner loop use the much faster
# `pnpm run typecheck` (~2s) — it catches the type-error class but not build- or
# render-time failures.
#
# NEVER BLOCKS ON INFRASTRUCTURE. Missing deps, absent pnpm, a failed install —
# all warn and exit 0. Only a genuine build failure exits non-zero. A hook that
# hard-fails on setup gets bypassed permanently, which protects nothing.
#
# It DOES auto-install site deps when absent (~4s against a warm pnpm store),
# because worktrees start without them: .worktreeinclude cannot carry
# node_modules (a copy is multi-GB, and Turbopack rejects a symlinked
# node_modules outright — "points out of the filesystem root"). Without this the
# hook would silently skip in exactly the worktrees where the work happens.
#
# CAVEAT: it builds the WORKING TREE, while the range it inspects is the commits
# being pushed. Those agree in the normal commit-then-push flow, but not when you
# push a branch other than the one checked out — there it can pass on a tree that
# is not what ships. CI's Site build job checks the pushed commit itself.
#
# Bypass: NUB_SKIP_SITE_CHECK=1 git push   ·   git push --no-verify
#
# core.hooksPath is .githooks, so this is active in every worktree with no
# per-clone setup step.

SKILLS_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

# ---------------------------------------------------------------------------
# Skill-tree integrity. Runs FIRST, unconditionally, and never touches stdin.
#
# WHY THIS EXISTS: skills are the repo's agent tooling, and every way they break
# is SILENT — no error, no missing-file message, just an agent that quietly no
# longer knows how to do something. Three real failures motivate the checks:
#
#   1. A duplicate tree under .agents/skills drifted for weeks against
#      .claude/skills, so agents reading it followed a model-tiering policy that
#      had been reversed, and two skills existed there that Claude never saw.
#   2. A directory symlink was considered as the anti-drift fix and rejected: git
#      on Windows without core.symlinks writes it out as a text file, which turns
#      "one shared tree" into "zero skills" with nothing on stderr.
#   3. A per-skill entry in .git/info/exclude makes `git add` silently REFUSE a
#      canonical skill, so it vanishes from the repo while still sitting on disk.
#
# Deliberately NOT gated on the pushed range: a bad tree usually arrives via a
# merge or a checkout, not via your own edit. It costs a few milliseconds.
#
# Unlike the site gate below, this one has no infrastructure to fail on — it is
# file tests and greps — so a failure here is always a real defect.
#
# Bypass: git push --no-verify
# ---------------------------------------------------------------------------
if [ -n "$SKILLS_ROOT" ] && [ -e "$SKILLS_ROOT/.claude/skills" ]; then
  skills_bad=0

  # A symlink here is the Windows-degradation trap; a non-directory is worse.
  if [ -L "$SKILLS_ROOT/.claude/skills" ] || [ ! -d "$SKILLS_ROOT/.claude/skills" ]; then
    echo "pre-push: .claude/skills must be a real directory, not a symlink or file." >&2
    echo "          A symlink degrades to a plain text file on a Windows clone," >&2
    echo "          silently leaving every agent with zero skills." >&2
    skills_bad=1
  fi

  # No rival AGENT-PLAYBOOK tree. .claude/skills is the single source of truth.
  # NOT checked: the repo-root skills/ directory, which is the published
  # user-facing nub skill served at nubjs.com/skill.md — a different artifact
  # with a different audience, not an agent playbook.
  for rival in "$SKILLS_ROOT/.agents/skills" "$SKILLS_ROOT/.opencode/skills"; do
    [ -d "$rival" ] || continue
    if find "$rival" -name SKILL.md 2>/dev/null | grep -q .; then
      echo "pre-push: a second agent-skill tree exists at ${rival#"$SKILLS_ROOT"/} — playbooks" >&2
      echo "          must live only in .claude/skills. Two trees drift silently; that is" >&2
      echo "          the bug this check exists to prevent. Move them in, delete the copy." >&2
      skills_bad=1
    fi
  done

  # Every skill directory needs a SKILL.md carrying name + description, or the
  # harness will not register it — again, with no error shown to anyone.
  for d in "$SKILLS_ROOT"/.claude/skills/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if [ ! -f "$d/SKILL.md" ]; then
      echo "pre-push: .claude/skills/$name has no SKILL.md — it will never register." >&2
      skills_bad=1
      continue
    fi
    for field in name description; do
      if ! head -20 "$d/SKILL.md" | grep -q "^${field}:"; then
        echo "pre-push: .claude/skills/$name/SKILL.md has no frontmatter \`${field}:\`" >&2
        echo "          — without it the skill is invisible to every agent." >&2
        skills_bad=1
      fi
    done
  done

  # A canonical skill that git refuses to track is the .git/info/exclude trap.
  for d in "$SKILLS_ROOT"/.claude/skills/*/; do
    [ -f "$d/SKILL.md" ] || continue
    name=$(basename "$d")
    case "$name" in nub|sandbox-pentest) continue ;; esac  # deliberately local-only
    if git -C "$SKILLS_ROOT" check-ignore -q ".claude/skills/$name/SKILL.md" 2>/dev/null; then
      echo "pre-push: .claude/skills/$name is git-IGNORED, so \`git add\` silently skips it." >&2
      echo "          Remove its entry from .gitignore or .git/info/exclude." >&2
      skills_bad=1
    fi
  done

  # The gh-comment-guard exists once per agent (.claude/ for Claude Code, .codex/
  # for Codex) because the two read different config files — there is no shared
  # hook location. The SCRIPT, though, is agent-neutral: both runners pass a JSON
  # payload with tool_input.command on stdin. Two copies with no sync is exactly
  # how the skills tree drifted, so require them byte-identical.
  claude_guard="$SKILLS_ROOT/.claude/hooks/gh-comment-guard.mjs"
  codex_guard="$SKILLS_ROOT/.codex/hooks/gh-comment-guard.mjs"
  if [ -f "$claude_guard" ] && [ -f "$codex_guard" ] && ! cmp -s "$claude_guard" "$codex_guard"; then
    echo "pre-push: .claude/hooks/gh-comment-guard.mjs and .codex/hooks/gh-comment-guard.mjs" >&2
    echo "          have DRIFTED. They are per-agent copies of one script and must match;" >&2
    echo "          copy whichever is correct over the other." >&2
    skills_bad=1
  fi

  # A hook command carrying someone's home directory works on exactly one machine
  # and in no worktree. Codex sets NO project-dir env var (verified: the binary
  # has neither CLAUDE_PROJECT_DIR nor CODEX_PROJECT_DIR), so the portable form
  # is a command substitution — $(git rev-parse --show-toplevel).
  if [ -f "$SKILLS_ROOT/.codex/hooks.json" ] && grep -q '"command".*/Users/\|"command".*/home/' "$SKILLS_ROOT/.codex/hooks.json"; then
    echo "pre-push: .codex/hooks.json hardcodes an absolute home path — it will break in" >&2
    echo "          every worktree and on every other machine. Use:" >&2
    echo "          node \"\$(git rev-parse --show-toplevel)/.codex/hooks/gh-comment-guard.mjs\"" >&2
    skills_bad=1
  fi

  if [ "$skills_bad" = 1 ]; then
    echo >&2
    echo "pre-push: AGENT TOOLING INTEGRITY CHECK FAILED — fix the above, or bypass" >&2
    echo "          with: git push --no-verify" >&2
    exit 1
  fi
fi

# ── Knowledge-graph gate ────────────────────────────────────────────────
#
# WHY THIS EXISTS: `lat check` validates the wiki/ graph AND the `@lat:`
# backlinks in Rust source, so a rename in crates/ can break it just as a doc
# edit can. Without this, a broken graph is only caught by the lat-check job
# after the push. lat-check.yml does run on pull requests to main, so the gap it
# leaves is narrower than "nothing": a branch pushed with no PR open yet, and a
# stacked PR based on another branch, which the workflow's own header names.
#
# Runs unconditionally rather than on a path filter, because the failure mode is
# cross-cutting: the source half of the graph is exactly what a path filter for
# wiki/** would miss. ~5s warm.
#
# NEVER BLOCKS ON INFRASTRUCTURE, matching the site gate below: only a genuine
# "errors found" from the checker exits non-zero. An npx that cannot reach the
# registry, a missing Node — all warn and pass. A hook that hard-fails on setup
# gets bypassed permanently, which protects nothing.
#
# Bypass: NUB_SKIP_LAT_CHECK=1 git push   ·   git push --no-verify
if [ -z "${NUB_SKIP_LAT_CHECK:-}" ] && [ -n "$SKILLS_ROOT" ] && [ -d "$SKILLS_ROOT/wiki" ]; then
  lat_out=$(cd "$SKILLS_ROOT" && npm run --silent lat:check 2>&1)
  lat_rc=$?
  if printf '%s' "$lat_out" | grep -qE "[0-9]+ errors? found"; then
    printf '%s\n' "$lat_out" | grep "^- " | head -20 >&2
    cat >&2 <<'MSG'

pre-push: LAT CHECK FAILED — the knowledge graph has broken links or refs.
          Fix them, or bypass with:  git push --no-verify
MSG
    exit 1
  elif [ "$lat_rc" -ne 0 ]; then
    echo "pre-push: could not run lat check — skipping the graph gate." >&2
    printf '%s\n' "$lat_out" | tail -3 | sed -e 's/^/          /' >&2
  fi
fi

[ "${NUB_SKIP_SITE_CHECK:-}" = "1" ] && exit 0

ROOT="$SKILLS_ROOT"
[ -n "$ROOT" ] || exit 0
[ -d "$ROOT/site" ] || exit 0

# Decide whether the pushed range touches site/**. FAIL SAFE, matching the
# matrix-plan job's philosophy in ci.yml: a range we cannot resolve runs the
# check rather than skipping it. Skipping costs a broken deployment; running
# costs 20 seconds.
site_touched=0
undecidable=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # An all-zero local sha is a branch deletion — nothing to build.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_sha" in
    # Existing remote branch: diff exactly what this push adds.
    *[!0]*) base="$remote_sha" ;;
    # New remote branch: fall back to where it forked from trunk.
    *) base=$(git merge-base "$local_sha" origin/main 2>/dev/null) ;;
  esac
  if [ -z "$base" ]; then
    undecidable=1
    continue
  fi
  changed=$(git diff --name-only "$base" "$local_sha" -- site/ 2>/dev/null) || undecidable=1
  [ -n "$changed" ] && site_touched=1
done

[ "$site_touched" = 1 ] || [ "$undecidable" = 1 ] || exit 0

if [ ! -x "$ROOT/site/node_modules/.bin/next" ]; then
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "pre-push: site/ changed, but site deps are absent and pnpm is not on PATH — skipping." >&2
    echo "          CI's 'Site build' job is the backstop for anything reaching main." >&2
    exit 0
  fi
  echo "pre-push: site/ changed — installing site deps (first run in this worktree)…"
  if ! (cd "$ROOT/site" && pnpm install --frozen-lockfile --config.strictDepBuilds=false) >/dev/null 2>&1; then
    echo "pre-push: site dep install failed — skipping the build rather than blocking the push." >&2
    echo "          Run it by hand to see why:  (cd site && pnpm install)" >&2
    exit 0
  fi
fi

echo "pre-push: site/ changed — running \`next build\` (the build Vercel runs)…"
LOG=$(mktemp) || exit 0
if (cd "$ROOT/site" && ./node_modules/.bin/next build) >"$LOG" 2>&1; then
  rm -f "$LOG"
  exit 0
fi

echo >&2
tail -40 "$LOG" >&2
rm -f "$LOG"
cat >&2 <<'MSG'

pre-push: SITE BUILD FAILED — pushing this would break the Vercel deployment.
          Fix it, or bypass with:  git push --no-verify
MSG
exit 1
