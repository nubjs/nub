{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "typeRoots": [
      "./test-types/node_modules/@types"
    ]
  },
  "include": [
    "*.test.mts"
  ]
}
