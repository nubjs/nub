From d7e3ce87ede4e4589a5686ac94aafa2fd384e0f9 Mon Sep 17 00:00:00 2001
From: Colin McDonnell <colin@pullfrog.com>
Date: Fri, 4 Sep 2026 16:48:45 -0700
Subject: [PATCH] build: delay-load CoreFoundation and Security on macOS

A macOS node process runs about 660 dyld initializers before main. Only
253 of them are node's own; the other ~404 belong to the dependency tree
CoreFoundation and Security drag in -- Foundation, libobjc, the Swift
runtime, SkyLight, CoreDisplay, and Network.framework, whose
initializers alone number 365. Measured on macOS 26.6.2 arm64, and on
macOS 15.7.9 for the two control binaries:

  DYLD_PRINT_INITIALIZERS=1 <trivial C binary>                       2
  DYLD_PRINT_INITIALIZERS=1 <the same, -framework CoreFoundation>  404
  DYLD_PRINT_INITIALIZERS=1 node -e 0                              657

Nothing on the startup path uses either framework. dyld_info -fixups on
the shipped v26.7.0 binary finds 37 bindings into the two: 14 Security
symbols and 18 CoreFoundation ones reached only through
--use-system-ca (src/crypto/crypto_context.cc), and 5 CoreFoundation
ones from cctz's local_time_zone(), which only absl::LocalTimeZone()
calls.

Mark both frameworks delay-init so dyld defers the load, and those
initializers, to the first call. The dependency itself is unchanged:
otool -L still lists both, and a dlopen or any call still loads them.
That is the difference from removing the link outright, which was
proposed and dropped in 2022.

The four kSecTrustSettings* dictionary keys are the one thing that
cannot be delayed. The SDK spells them as CFSTR() macros, which emit
__DATA_CONST,__cfstring literals whose isa pointer binds to
CoreFoundation's constant-string class before main, and ld rejects the
link with "ptr64 use of '___CFConstantStringClassReference' in 'anon'
cannot be delayed". Build the four strings on first use instead.

Two notes for the build:

- The delay flags belong on the linked target's 'libraries' and nowhere
  else. gyp hands a static library target's OTHER_LDFLAGS straight to
  libtool, which special-cases '-framework X' as a warning but fails the
  archive on '-Wl,...'. Naming the frameworks once, on the executable
  link, also removes the risk of an eager '-framework' elsewhere on the
  line winning over the delayed one.
- ld warns "delay-init will be ignored for 'CoreFoundation' because
  deployment target version is too low" at MACOSX_DEPLOYMENT_TARGET
  13.5. It emits the marker anyway, and dyld honours it: a binary built
  at 13.5 runs 4 initializers instead of 402 on macOS 15.7.9 and 5
  instead of 404 on macOS 26.5.2. Only dyld before macOS 15 ignores it,
  and there the behaviour is exactly what ships today.

Refs: https://github.com/nodejs/node/issues/44715
Refs: https://github.com/nodejs/node/commit/b1741ea1fadf
Refs: https://github.com/denoland/deno/pull/35341
---
 node.gypi                    | 19 +++++++++++---
 src/crypto/crypto_context.cc | 48 ++++++++++++++++++++++++++++++------
 2 files changed, 55 insertions(+), 12 deletions(-)

diff --git a/node.gypi b/node.gypi
index 104e884e6..60d17df46 100644
--- a/node.gypi
+++ b/node.gypi
@@ -265,10 +265,21 @@
     }],
 
     [ 'OS=="mac"', {
-      # linking Corefoundation is needed since certain macOS debugging tools
-      # like Instruments require it for some features. Security is needed for
-      # --use-system-ca.
-      'libraries': [ '-framework CoreFoundation -framework Security' ],
+      # CoreFoundation is only reached through cctz's local_time_zone(), and
+      # Security only through --use-system-ca; between them they are ~400 of
+      # the ~660 dyld initializers a node process runs at launch. Delay-init
+      # keeps the dependency -- Instruments still resolves it, and a dlopen or
+      # the first call loads it -- but moves the load off the launch path.
+      # dyld before macOS 15 ignores the marker and loads eagerly, as today.
+      #
+      # This has to be a 'libraries' entry on the linked target, and it has to
+      # be the only place the frameworks are named: gyp hands a static library
+      # target's OTHER_LDFLAGS straight to libtool, which quietly ignores
+      # '-framework X' but fails the archive on '-Wl,...'.
+      'libraries': [
+        '-Wl,-delay_framework,CoreFoundation',
+        '-Wl,-delay_framework,Security',
+      ],
       'defines!': [
         'NODE_PLATFORM="mac"',
       ],
diff --git a/src/crypto/crypto_context.cc b/src/crypto/crypto_context.cc
index 9dc68f4d9..0616bc6f4 100644
--- a/src/crypto/crypto_context.cc
+++ b/src/crypto/crypto_context.cc
@@ -325,11 +325,39 @@ bool isSelfIssued(X509* cert) {
 // See https://chromium.googlesource.com/chromium/src/+/HEAD/LICENSE for
 // details.
 #ifdef __APPLE__
+enum class TrustSettingsKey { kApplication, kPolicy, kPolicyString, kResult };
+
+// The SDK spells these dictionary keys as CFSTR() literals. A CFSTR() literal
+// lands in __DATA_CONST,__cfstring with its isa pointer bound to
+// CoreFoundation's constant-string class, and dyld resolves that bind before
+// main -- which pins CoreFoundation to the launch path of every process even
+// though only --use-system-ca ever reads these keys. Building the strings on
+// first use is what lets node.gypi delay-load the framework. Like the literals
+// they replace, these live for the process and are never released.
+CFStringRef GetTrustSettingsKey(TrustSettingsKey key) {
+  static const CFStringRef keys[] = {
+      CFStringCreateWithCString(kCFAllocatorDefault,
+                                "kSecTrustSettingsApplication",
+                                kCFStringEncodingASCII),
+      CFStringCreateWithCString(kCFAllocatorDefault,
+                                "kSecTrustSettingsPolicy",
+                                kCFStringEncodingASCII),
+      CFStringCreateWithCString(kCFAllocatorDefault,
+                                "kSecTrustSettingsPolicyString",
+                                kCFStringEncodingASCII),
+      CFStringCreateWithCString(kCFAllocatorDefault,
+                                "kSecTrustSettingsResult",
+                                kCFStringEncodingASCII),
+  };
+  return keys[static_cast<size_t>(key)];
+}
+
 TrustStatus IsTrustDictionaryTrustedForPolicy(CFDictionaryRef trust_dict,
                                               bool is_self_issued) {
   // Trust settings may be scoped to a single application
   // skip as this is not supported
-  if (CFDictionaryContainsKey(trust_dict, kSecTrustSettingsApplication)) {
+  if (CFDictionaryContainsKey(
+          trust_dict, GetTrustSettingsKey(TrustSettingsKey::kApplication))) {
     return TrustStatus::UNSPECIFIED;
   }
 
@@ -338,7 +366,8 @@ TrustStatus IsTrustDictionaryTrustedForPolicy(CFDictionaryRef trust_dict,
   // settings specific to a particular WiFi network.
   // As this is not presently supported, skip any policy-specific trust
   // settings.
-  if (CFDictionaryContainsKey(trust_dict, kSecTrustSettingsPolicyString)) {
+  if (CFDictionaryContainsKey(
+          trust_dict, GetTrustSettingsKey(TrustSettingsKey::kPolicyString))) {
     return TrustStatus::UNSPECIFIED;
   }
 
@@ -346,9 +375,11 @@ TrustStatus IsTrustDictionaryTrustedForPolicy(CFDictionaryRef trust_dict,
   // kSecTrustSettingsPolicy), ensure that the policy is the same policy as
   // |kSecPolicyAppleSSL|. If there is no kSecTrustSettingsPolicy key, it's
   // considered a match for all policies.
-  if (CFDictionaryContainsKey(trust_dict, kSecTrustSettingsPolicy)) {
-    SecPolicyRef policy_ref = reinterpret_cast<SecPolicyRef>(const_cast<void*>(
-        CFDictionaryGetValue(trust_dict, kSecTrustSettingsPolicy)));
+  if (CFDictionaryContainsKey(trust_dict,
+                              GetTrustSettingsKey(TrustSettingsKey::kPolicy))) {
+    SecPolicyRef policy_ref =
+        reinterpret_cast<SecPolicyRef>(const_cast<void*>(CFDictionaryGetValue(
+            trust_dict, GetTrustSettingsKey(TrustSettingsKey::kPolicy))));
 
     if (!policy_ref) {
       return TrustStatus::UNSPECIFIED;
@@ -369,10 +400,11 @@ TrustStatus IsTrustDictionaryTrustedForPolicy(CFDictionaryRef trust_dict,
   }
 
   int trust_settings_result = kSecTrustSettingsResultTrustRoot;
-  if (CFDictionaryContainsKey(trust_dict, kSecTrustSettingsResult)) {
+  if (CFDictionaryContainsKey(trust_dict,
+                              GetTrustSettingsKey(TrustSettingsKey::kResult))) {
     CFNumberRef trust_settings_result_ref =
-        reinterpret_cast<CFNumberRef>(const_cast<void*>(
-            CFDictionaryGetValue(trust_dict, kSecTrustSettingsResult)));
+        reinterpret_cast<CFNumberRef>(const_cast<void*>(CFDictionaryGetValue(
+            trust_dict, GetTrustSettingsKey(TrustSettingsKey::kResult))));
 
     if (!trust_settings_result_ref ||
         !CFNumberGetValue(trust_settings_result_ref,
-- 
2.38.1

