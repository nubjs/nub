# The Vercel project's Root Directory is `site/`. Keep CLI/git deploy uploads
# lean, but retain the canonical Nub package manifest used by docs version
# substitution.
/.repos
/tests
/wiki
/epics
/.claude
/.scripts
/benchmarks
/crates
/npm/*
!/npm/nub/
/npm/nub/*
!/npm/nub/package.json
/runtime
/docker
/.github
