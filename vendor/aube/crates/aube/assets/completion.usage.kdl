// Dynamic completion follows mise's custom-completer pattern: the usage
// spec delegates candidate production to a hidden, machine-oriented CLI mode.
//
// usage renders the current token into `sh -c`. Wrap it in single quotes and
// replace every embedded apostrophe with the POSIX close/escape/reopen form so
// arbitrary input remains one inert argument.
complete "package" run=#"{bin} completion _ --complete package --query='{{ words[CURRENT] | replace(from="'", to="'\\''") }}'"# descriptions=#true
complete "packages" run=#"{bin} completion _ --complete package --query='{{ words[CURRENT] | replace(from="'", to="'\\''") }}'"# descriptions=#true
complete "pkg" run=#"{bin} completion _ --complete package --query='{{ words[CURRENT] | replace(from="'", to="'\\''") }}'"# descriptions=#true
complete "bin" run="{bin} completion _ --complete bin" descriptions=#true
complete "workspace" run="{bin} completion _ --complete workspace" descriptions=#true
complete "key" run="{bin} completion _ --complete setting" descriptions=#true
complete "patch" run="{bin} completion _ --complete patch" descriptions=#true
complete "dir" type="dir"
complete "path" type="path"
