cmd login help="Store a registry auth token in the user's ~/.npmrc" effect=write {
    alias adduser
    flag --auth-type help="Authentication flow: `legacy` (token paste; default) or `web` (OAuth flow against `{registry}/-/v1/login`)." default=legacy {
        arg <TYPE>
    }
    flag --scope help="Scope to bind this registry to (e.g. `@myorg`)." {
        long_help #"""
Scope to bind this registry to (e.g. `@myorg`).

When set, the scope->registry mapping is also written to `~/.npmrc`.
"""#
        arg <SCOPE>
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd logout help="Remove a registry auth token from the user's ~/.npmrc" effect=destructive {
    flag --scope help="Scope whose registry mapping should also be removed (e.g. `@myorg`)." {
        arg <SCOPE>
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd node help="Run Node.js through aube's project runtime resolver" {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Arguments to pass to Node.js" double_dash=automatic
}
cmd outdated help="Report dependencies whose installed version lags behind the registry" effect=read {
    flag "-D --dev" help="Show only devDependencies" conflicts=--prod
    flag "-g --global" help="Check globally-installed packages instead of the current project." conflicts=--workspace-root
    flag --json help="Emit a JSON object keyed by package name instead of the default table"
    flag --long help="Also show deps whose `wanted` version matches the installed version"
    flag "-P --prod --production" help="Show only production dependencies (skip devDependencies)" conflicts=--dev
    flag "-w --workspace-root --workspace" help="Operate on the workspace root regardless of cwd." {
        long_help #"""
Operate on the workspace root regardless of cwd.

Mirrors pnpm's `-w/--workspace-root`: from a sub-package, `aube outdated -w` reports the root manifest's deps instead of the sub-package's. No-op when paired with `-r` / `--filter` (those already drive workspace selection from the root).
"""#
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PATTERN]" help="Optional package name (prefix match) to filter the report"
}
cmd owner help="Manage package owners (not implemented — use `npm owner`)" hide=#true effect=read {
    use fallback-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic
}
cmd pack help="Create a publishable `.tgz` tarball from the current project" effect=write {
    flag --dry-run help="Don't write the tarball; print what would be packed"
    flag --ignore-scripts help="Skip `prepack` / `prepare` / `postpack` lifecycle scripts."
    flag --json help="Print the result as a JSON object"
    flag --pack-destination help="Directory to write the tarball into (default: current directory)" {
        arg <DIR>
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd patch help="Extract a package into an edit directory so it can be patched" effect=write {
    flag --edit-dir help="Directory to extract the writable copy into." {
        long_help #"""
Directory to extract the writable copy into.

When omitted, `aube` picks a fresh temp dir under the system tmpdir.
"""#
        arg <DIR>
    }
    flag --ignore-existing help="Ignore any existing patch entry for this package." {
        long_help #"""
Ignore any existing patch entry for this package.

Extracts a pristine copy from `node_modules` rather than re-applying the existing patch first. Accepted for pnpm parity; aube already extracts from the *linked* (post-patch) tree, so this flag is effectively informational here.
"""#
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGE> help="Package spec, `<name>@<version>`." {
        long_help #"""
Package spec, `<name>@<version>`.

The package must already be installed in `node_modules` (aube copies from the linked virtual store, not from the registry, so the layout matches what install would later patch).
"""#
    }
}
cmd patch-commit help="Generate a `.patch` file from an `aube patch` edit directory" effect=write {
    flag --patches-dir help="Where to write the generated `.patch` file, relative to the project root." default=patches {
        long_help #"""
Where to write the generated `.patch` file, relative to the project root.

Defaults to `patches`.

Ignored when the dependency already has a declared patch path; the existing path is always reused in that case.
"""#
        arg <DIR>
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <DIR> help="The edit directory printed by `aube patch`." {
        long_help #"""
The edit directory printed by `aube patch`.

The matching source snapshot is read from a sibling `source/` dir, located via the `.aube_patch_state.json` sidecar.
"""#
    }
}
cmd patch-remove help="Remove patch entries from `pnpm.patchedDependencies`" effect=destructive {
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PATCH]..." help="Patch keys to remove, formatted as `<name>@<version>`." {
        long_help #"""
Patch keys to remove, formatted as `<name>@<version>`.

Same shape used as the `pnpm.patchedDependencies` map key. With no arguments, every declared patch is removed.
"""#
    }
}
cmd peers help="Inspect peer-dependency resolution from the lockfile" effect=read subcommand_required=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd check help="Check for unmet and missing peer-dependency issues by reading the lockfile." effect=read {
        long_help #"""
Check for unmet and missing peer-dependency issues by reading the lockfile.

Exits with status 1 if any issue is reported.
"""#
        after_long_help #"""
Examples:

  $ aube peers check
  All peer dependencies are satisfied.

  # With issues
  $ aube peers check
  1 unmet, 1 missing peer dependencies:

  ├─┬ @emotion/react@11.11.4
  │ └── ✕ unmet peer react@>=16.8: found 17.0.2
  └─┬ react-dom@18.2.0
    └── ✕ missing peer react@^18.0.0

  # Machine-readable
  $ aube peers check --json

"""#
        flag --json help="Emit a JSON report instead of the human-readable tree."
        flag "-h --help" help="Print help" action=help builtin=#true
    }
}
cmd pkg help="Manage package.json entries (not implemented — use `npm pkg`)" hide=#true effect=read {
    use fallback-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic
}
cmd prefix help="Print the current package prefix directory" effect=read {
    flag "-g --global" help="Print the global prefix directory instead of the project's root"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd prune help="Remove extraneous packages from project `node_modules`." effect=write {
    long_help #"""
Remove extraneous packages from project `node_modules`.

Reads the lockfile, computes the packages still reachable from each importer, and removes stale top-level links, stale virtual-store entries, and dangling .bin links. Does not modify package.json or the lockfile.
"""#
    flag "-P --prod --production" help="Remove devDependencies from node_modules"
    flag --no-optional help="Also remove optionalDependencies"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd publish help="Publish the current package to the registry" effect=write {
    flag --access help="Publish as `public` or `restricted`." {
        long_help #"""
Publish as `public` or `restricted`.

Sent as the `access` field in the publish body; scoped packages default to `restricted` on the registry side, so pass `--access=public` to make a new scoped package world-readable.
"""#
        arg <LEVEL>
    }
    flag --dry-run help="Don't upload; print what would be published."
    flag --force help="Republish even when the version is already on the registry." {
        long_help #"""
Republish even when the version is already on the registry.

By default `aube publish` issues a GET before the PUT and refuses to proceed when the version exists, surfacing a clear error instead of relying on the registry to return 409. In `--recursive` / `--filter` mode, `--force` overrides the silent "already-published" skip so every selected workspace package is re-PUT. The registry must still accept the republish — npm's public registry rejects re-publishes outright; Verdaccio and most private mirrors allow them.
"""#
    }
    flag --ignore-scripts help="Skip publish lifecycle scripts." {
        long_help #"""
Skip publish lifecycle scripts.

Suppresses `prepublishOnly`, `prepublish`, `prepack`, `prepare`, `postpack`, `publish`, and `postpublish` scripts for this publish.
"""#
    }
    flag --json help="Emit the publish result as JSON." {
        long_help #"""
Emit the publish result as JSON.

Output matches `npm publish --json` / `pnpm publish --json`; recursive multi-package publishes emit an array.
"""#
    }
    flag --no-git-checks help="Skip the \"working tree must be clean\" check." {
        long_help #"""
Skip the "working tree must be clean" check.

When unset, aube refuses to publish from a dirty git checkout (uncommitted tracked changes) or from a detached / non-release branch.
"""#
    }
    flag --otp help="One-time password for registries that require 2FA." {
        long_help #"""
One-time password for registries that require 2FA.

Sent verbatim as the `npm-otp` header.
"""#
        arg <CODE>
    }
    flag --provenance help="Generate a SLSA provenance attestation and attach it to the publish body." {
        long_help #"""
Generate a SLSA provenance attestation and attach it to the publish body.

Requires an OIDC-capable CI environment (GitHub Actions with `id-token: write`, GitLab CI, Buildkite, or CircleCI) — aube signs via the Sigstore public-good instance (Fulcio + Rekor) and attaches the resulting bundle so registries that honor npm's provenance protocol light up the "provenance" badge on the published version.
"""#
    }
    flag --tag help="Default dist-tag to publish under (default: `latest`)." {
        arg <TAG>
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[TARBALL|FOLDER]" help="Tarball or package directory to publish (default: current package)."
}
cmd purge help="Alias for `clean` — remove `node_modules` across every workspace project." effect=write {
    long_help #"""
Alias for `clean` — remove `node_modules` across every workspace project.

A `purge` script in the root `package.json` overrides the built-in.
"""#
    use clean-args
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd query help="Query packages in the resolved dependency graph" effect=read {
    flag "-D --dev" help="Only match devDependency roots and their transitive deps." conflicts=--prod
    flag "-P --prod --production" help="Only match production/optional roots and their transitive deps." conflicts=--dev
    flag --json help="Emit a JSON array instead of the default text layout." conflicts=--parseable
    flag --parseable help="Emit tab-separated rows: dep_path, name, version, source, flags."
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <SELECTOR> help="Selector expression." {
        long_help #"""
Selector expression.

Supports `*`, bare package names, `[name=value]`, `[version=value]`, `[license=value]`, `[depPath=value]`, `[source=value]`, `:prod`, `:dev`, `:optional`, `:peer`, `:transitive`, `:scripts`, `:bin`, `:deprecated`, `:license(value)`, and `:type(value)`.
"""#
    }
}
cmd rebuild help="Re-run root lifecycle scripts and allowlisted dependency builds" effect=write {
    alias rb
    long_help #"""
`aube rebuild [<pkg>...]` — without args, re-run the root package's preinstall hook, then install / postinstall work for dependency packages allowed by the active `allowBuilds` / `onlyBuiltDependencies` policy, then the root package's install / postinstall / prepare lifecycle hooks.

With one or more package names, run lifecycle scripts only for the named deps and skip the root hooks. Match is by graph `name`, which is the in-tree alias when one is configured (so `aube rebuild my-alias` works for a manifest entry like `"my-alias": "npm:real-pkg@1.0"`, matching pnpm).

Unlike the other lifecycle shortcuts, `rebuild` intentionally does not auto-install: `aube install` already runs these same four hooks after linking, so triggering an install here would double-run every script on a stale tree. Users who actually want a fresh install should run `aube install`.
"""#
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PACKAGE]..." help="Optional package names. When supplied, only matching deps' scripts run; the root lifecycle hooks (preinstall, install, postinstall, prepare) are skipped. Match is by graph `name`, not by `dep_path`. The active `allowBuilds` / `onlyBuiltDependencies` policy is bypassed for the named deps — naming the package is the explicit opt-in."
}
cmd recursive help="Run a supported command across workspace packages" {
    alias multi
    alias m
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Command and arguments to run recursively across workspace packages" double_dash=automatic
}
cmd remove help="Remove a dependency" effect=destructive {
    alias rm
    alias uninstall
    alias un
    alias uni
    flag "-D --save-dev" help="Remove only from devDependencies"
    flag "-g --global" help="Remove from the global install directory instead of the project"
    flag --ignore-scripts help="Skip root lifecycle scripts during the chained reinstall"
    flag "-w --workspace" help="Remove the dependency from the workspace root's `package.json`." conflicts=--global {
        long_help #"""
Remove the dependency from the workspace root's `package.json`.

Applies regardless of the current working directory: walks up from cwd looking for `aube-workspace.yaml`, `pnpm-workspace.yaml`, or a `package.json` with a `workspaces` field and runs the remove against that directory. Takes precedence over `--filter` when both are supplied (same as `add --workspace`).
"""#
    }
    use lockfile-args
    use network-args
    use virtual-store-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PACKAGES]..." help="Package(s) to remove"
}
cmd restart help="Restart a package (shortcut for `run restart`; falls back to `stop` + `start`)" {
    use script-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Arguments to pass to the script" double_dash=automatic
}
cmd root help="Print the path to `node_modules`" effect=read {
    flag "-g --global" help="Print the global package directory instead of the project's"
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd run help="Run a script defined in package.json" {
    alias run-script
    flag --complete help="Print the nearest `package.json`'s scripts for shell completion." hide=#true {
        long_help #"""
Print the nearest `package.json`'s scripts for shell completion.

Consumed by the `complete "script"` node in the usage spec, not meant to be typed by hand.
"""#
    }
    flag --if-present help="Don't error if the script is missing from package.json"
    flag --inspect help="Forward `--inspect` to a Node-backed script or local binary." require_equals=#true value_optional=#true default_missing="" {
        arg "[[[HOST:]PORT]]" required=#false
    }
    flag --inspect-brk help="Forward `--inspect-brk` to a Node-backed script or local binary." require_equals=#true value_optional=#true default_missing="" {
        arg "[[[HOST:]PORT]]" required=#false
    }
    flag --no-bail help="Continue recursive execution after a script fails." {
        long_help #"""
Continue recursive execution after a script fails.

Parsed for pnpm compatibility; aube's sequential fanout still stops on first failure.
"""#
    }
    flag --no-install help="Skip auto-install check"
    flag --no-sort help="Disable topological sorting (default is on)." overrides=--sort {
        long_help #"""
Disable topological sorting (default is on).

Without this, recursive runs visit packages in a deps-first order so a `build` script in a shared library finishes before a dependent app's `build` starts. Pass this to fall back to the raw workspace-listing order.
"""#
    }
    flag --parallel help="Run the script in every matched workspace package concurrently." {
        long_help #"""
Run the script in every matched workspace package concurrently.

Unbounded parallelism. Pair with `--workspace-concurrency=N` to cap the worker count. Single-package runs ignore this flag. First non-zero exit fails the whole run, but siblings are allowed to finish so their output isn't truncated. Child stdio is piped and lines are emitted with a `<package>: ` prefix; pass `--reporter-hide-prefix` to drop the labels.
"""#
    }
    flag --report-summary help="Write a recursive run summary file." {
        long_help #"""
Write a recursive run summary file.

Parsed for pnpm compatibility.
"""#
    }
    flag --reporter-hide-prefix help="Hide the `<package>: ` label on parallel-run output lines." {
        long_help #"""
Hide the `<package>: ` label on parallel-run output lines.

Lines are still piped through aube (so the line breaks are clean even when many packages run at once), but the source package isn't named on each line. Sequential runs ignore this flag.
"""#
    }
    flag --resume-from help="Resume recursive execution starting at this package name." {
        long_help #"""
Resume recursive execution starting at this package name.

After the topo sort and `--reverse` are applied, packages before the named one in the resulting order are skipped. Errors if the name isn't in the matched workspace set.
"""#
        arg <PACKAGE>
    }
    flag --reverse help="Reverse the recursive execution order (after topo sort)." {
        long_help #"""
Reverse the recursive execution order (after topo sort).

Useful for teardown-style scripts where dependents must shut down before their deps.
"""#
    }
    flag --sort help="Sort recursive packages topologically (this is the default)." overrides=--no-sort {
        long_help #"""
Sort recursive packages topologically (this is the default).

Pass to override an earlier `--no-sort` on the same invocation.
"""#
    }
    flag -s help="Suppress aube's wrapper output while still showing script stdout/stderr." {
        long_help #"""
Suppress aube's wrapper output while still showing script stdout/stderr.

Short alias for the global `--silent` flag.
"""#
    }
    flag --workspace-concurrency help="Cap the number of recursive packages running at once." {
        long_help #"""
Cap the number of recursive packages running at once.

Setting this implicitly enables parallel mode at width `N`. `0` means "use the available CPU count". Without this flag, `--parallel` stays unbounded.
"""#
        arg <N>
    }
    use lockfile-args
    use network-args
    use virtual-store-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[SCRIPT]" help="Script or local binary name." {
        long_help #"""
Script or local binary name.

Omit on an interactive TTY to pick from `package.json` scripts. If no script matches, aube falls back to `node_modules/.bin/<name>`.
"""#
    }
    arg "[ARGS]..." help="Arguments to pass to the script" double_dash=automatic
}
cmd runtime help="Manage the project's Node.js runtime (pin, install, inspect)" effect=read subcommand_required=#true {
    alias rt
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd list help="Show the resolved runtime and installed versions" effect=read {
        alias ls
        flag "-h --help" help="Print help" action=help builtin=#true
    }
    cmd set help="Pin a runtime in package.json devEngines.runtime and install it" effect=write {
        flag "-g --global" help="Install for the user instead of the project (delegates to `mise use -g node@<version>` when mise manages installs)"
        flag --on-fail help="`onFail` policy written to devEngines.runtime" default=download {
            arg <POLICY>
        }
        flag --save-exact help="Pin the exact resolved version instead of a caret range"
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <NAME> help="Runtime name (only `node` is supported)"
        arg <VERSION> help="Version request: an exact version, a range (`^24`, `22`), `lts`, `latest`, or an LTS codename (`lts/jod`)"
    }
}
cmd sbom help="Generate a Software Bill of Materials (CycloneDX or SPDX)" effect=read {
    flag "-D --dev" help="Show only devDependencies" conflicts=--prod
    flag --exclude-peers help="Exclude peer dependencies from CycloneDX output"
    flag --format help="Output format: `cyclonedx` (default) or `spdx`" default=cyclonedx {
        arg <FORMAT> {
            choices {
                choice cyclonedx
                choice spdx
            }
        }
    }
    flag --lockfile-only help="Describe the complete platform-independent lockfile graph"
    flag "-P --prod --production" help="Show only production dependencies (skip devDependencies)" conflicts=--dev
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd search help="Search the registry for packages (not implemented — use `npm search`)" hide=#true effect=read {
    use fallback-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic
}
cmd set help="Alias for `config set` (hidden; prefer `config set`)" hide=#true effect=write {
    flag --local help="Shortcut for `--location project`." conflicts=--location
    flag --location help="Which config location to write to." default=user {
        long_help #"""
Which config location to write to.

Defaults to `user`. Writes land in `.npmrc` for the npm-shared surface — per-host auth/cert templates, scoped registries, and settings tagged `npmShared = true` in the settings registry (`registry`, `proxy` / `https-proxy`, `engine-strict`, `ignore-scripts`, etc.) — so npm and yarn read the same value. aube-only and pnpm-only settings, plus unknown keys, land in aube's own config (`~/.config/aube/config.toml` at user scope, `<cwd>/.config/aube/config.toml` at project scope) where sibling tools don't see them.

Dotted writes for aube map settings (`allowBuilds.<pkg>`, `overrides.<pkg>`, …) edit one entry at a time. At project scope (`--local`) they land in `pnpm-workspace.yaml#<map>.<entry>` or `package.json#aube.<map>.<entry>` if no workspace yaml exists, the same place install reads from. User-scope dotted writes for these maps error: aube only reads them per project.
"""#
        arg <LOCATION> {
            choices {
                choice user help="User config (`~/.config/aube/config.toml` for known aube settings, `~/.npmrc` for registry/auth and unknown keys)"
                choice project help="`<cwd>/.npmrc`"
                choice global help="Alias for `user` — aube has no separate global config file."
            }
        }
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <KEY> help="Setting key (canonical name or `.npmrc` alias)."
    arg <VALUE> help="Value to write. Stored verbatim after `key=`."
}
cmd set-script help="Set a `package.json` script (not implemented — use `npm set-script`)" hide=#true effect=read {
    use fallback-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic
}
cmd sponsors help="Show the companies sponsoring aube and the jdx.dev open source tools" effect=read {
    flag "-h --help" help="Print help" action=help builtin=#true
}
cmd stage help="Stage packages for publishing (not implemented — use `npm stage`)" hide=#true effect=read {
    use fallback-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic
}
cmd start help="Start a package (shortcut for `run start`)" {
    use script-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Arguments to pass to the script" double_dash=automatic
}
cmd stop help="Stop a package (shortcut for `run stop`)" {
    use script-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Arguments to pass to the script" double_dash=automatic
}
cmd store help="Manage the global store" effect=read subcommand_required=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd add help="Add one or more packages to the global store without linking them into any project." effect=write {
        long_help #"""
Add one or more packages to the global store without linking them into any project.

Each argument is a package spec: `lodash`, `lodash@4.17.21`, `react@next`, or `express@^4`.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <PACKAGES>... help="Package specs to fetch into the store."
    }
    cmd path help="Show the store path." effect=read {
        flag "-h --help" help="Print help" action=help builtin=#true
    }
    cmd prune help="Remove unreferenced packages from the global store." effect=write {
        long_help #"""
Remove unreferenced packages from the global store.

Operates on the store printed by `aube store path`; it does not touch project node_modules directories, manifests, or lockfiles.

It removes global virtual-store graph entries not referenced by any registered project. Entries from older aube releases live outside the registry-managed versioned namespace and are not touched. It then prunes content-store files.

On reflink filesystems such as APFS or btrfs, link counts cannot prove project reachability, so content-store pruning relies on cached package indexes. Global virtual-store reachability comes from project links.
"""#
        flag --dry-run help="Do not actually delete anything; report what would be pruned."
        flag --json help="Emit the dry-run plan as one machine-readable JSON document." requires=--dry-run
        flag "-h --help" help="Print help" action=help builtin=#true
    }
    cmd status help="Verify the store against cached package indexes." effect=read {
        long_help #"""
Verify the store against cached package indexes.

Confirms every file referenced by a cached package index is still present in the store and that its BLAKE3 hash matches. Exits non-zero when any corruption is detected.
"""#
        flag "-h --help" help="Print help" action=help builtin=#true
    }
}
cmd test help="Run the `test` script (shortcut for `run test`)" {
    alias t
    use script-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Arguments to pass to the script" double_dash=automatic
}
cmd token help="Manage registry auth tokens (not implemented — use `npm token`)" hide=#true effect=read {
    use fallback-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic
}
cmd trust help="Inspect npm package publishing trust" effect=read subcommand_required=#true {
    flag "-h --help" help="Print help" action=help builtin=#true
    cmd check help="Check one package version for a publishing-trust downgrade" effect=read {
        after_long_help #"""
Examples:

  $ aube trust check @hono/node-server@1.19.17
  @hono/node-server@1.19.17: pass
  published: 2026-07-27T03:07:48.993Z
  current evidence: trusted publisher
  strongest earlier evidence: trusted publisher (2.0.10)

  # Evaluate the underlying policy even when aube has a built-in exception
  $ aube trust check @hono/node-server@1.19.15 --ignore-default-excludes

  # Machine-readable report
  $ aube trust check @hono/node-server@1.19.17 --json

"""#
        flag --ignore-default-excludes help="Evaluate the policy without aube's built-in package exceptions"
        flag --json help="Emit a JSON report"
        use network-args
        flag "-h --help" help="Print help" action=help builtin=#true
        arg <PACKAGE@VERSION> help="Exact npm package version to inspect" {
            long_help #"""
Exact npm package version to inspect

Example: `@hono/node-server@1.19.17`.
"""#
        }
    }
}
cmd undeprecate help="Clear an existing deprecation on the registry" effect=write {
    flag --dry-run help="Don't PUT anything — print which versions would be touched and exit."
    flag --otp help="One-time password from a 2FA authenticator; sent as `npm-otp`." {
        arg <CODE>
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGE> help="Package spec: `name`, `name@version`, or `name@<range>`." {
        long_help #"""
Package spec: `name`, `name@version`, or `name@<range>`.

Omitting the version clears the deprecation on every published version.
"""#
    }
}
cmd unlink help="Unlink a package (remove linked entries from node_modules)" effect=write {
    alias dislink
    flag "-g --global" help="Operate on the global link registry instead of the current project." {
        long_help #"""
Operate on the global link registry instead of the current project.

`aube unlink -g` removes the current package's entry from `$XDG_CACHE_HOME/aube/global-links`, `$HOME/.cache/aube/global-links` when `XDG_CACHE_HOME` is unset, or `%LOCALAPPDATA%\aube\global-links` on Windows; `aube unlink -g <name>` removes the named entry.
"""#
    }
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PACKAGE]" help="Package name to unlink (omit to unlink all linked dependencies)"
}
cmd unpublish help="Remove a package (or a single version) from the registry" effect=destructive {
    flag --dry-run help="Don't talk to the registry; print what the command would do."
    flag "-f --force" help="Required for whole-package unpublish (no `@version` in the spec)." {
        long_help #"""
Required for whole-package unpublish (no `@version` in the spec).

Single-version unpublish works without it — matching npm, which is more permissive about dropping one version than nuking every version in one call.
"""#
    }
    flag --otp help="One-time password for registries that require 2FA." {
        long_help #"""
One-time password for registries that require 2FA.

Sent verbatim as the `npm-otp` header.
"""#
        arg <CODE>
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[SPEC]" help="Package spec: `name`, `name@version`, or omitted to use the current project's `package.json`."
}
cmd update help="Update dependencies" effect=write {
    alias up
    alias upgrade
    flag "-D --dev" help="Update only devDependencies." conflicts=--prod
    flag "-E --exact --save-exact" help="Pin manifest specifiers to the resolved version with no range prefix." {
        long_help #"""
Pin manifest specifiers to the resolved version with no range prefix.

Pair with `--latest`: when the rewritten specifier replaces the caret/tilde original, drop the prefix so the manifest carries an exact pin (`"1.2.3"`) instead of `"^1.2.3"`. Mirrors `pnpm update --save-exact`.
"""#
    }
    flag "-g --global" help="Update globally installed packages." {
        long_help #"""
Update globally installed packages.

Parsed for pnpm compatibility.
"""#
    }
    flag "-i --interactive" help="Interactive update picker." {
        long_help #"""
Interactive update picker.

Parsed for pnpm compatibility.
"""#
    }
    flag "-L --latest" help="Update past the manifest range unless paired with `--no-save`." {
        long_help #"""
Update past the manifest range unless paired with `--no-save`.

Rewrites `package.json` specifiers to match the newly resolved versions (the registry's `latest` dist-tag, clamped by `minimumReleaseAge` / `resolution-mode` as usual). With `--no-save`, leaves the manifest range unchanged and resolves only to the newest version that range allows.
"""#
    }
    flag "-P --prod --production" help="Update only production dependencies." conflicts=--dev
    flag "-w --workspace" help="Update dependencies in the current workspace package."
    flag --depth help="Dependency traversal depth." {
        long_help #"""
Dependency traversal depth.

Parsed for pnpm compatibility but ignored: aube only ever refreshes direct deps (pnpm's `--depth 0` default). Setting the flag emits a one-line warning pointing at `rm aube-lock.yaml && aube install` for the `--depth Infinity` case.
"""#
        arg <DEPTH>
    }
    flag --global-pnpmfile help="Add a global pnpmfile that runs before the local one." conflicts=--ignore-pnpmfile {
        long_help #"""
Add a global pnpmfile that runs before the local one.

Mirrors pnpm's `--global-pnpmfile <path>`. The global hook runs first and the local hook (if any) runs second.
"""#
        arg <PATH>
    }
    flag --ignore-pnpmfile help="Skip running `.pnpmfile.mjs` / `.pnpmfile.cjs` hooks for this update."
    flag --ignore-scripts help="Skip lifecycle scripts." hide=#true {
        long_help #"""
Skip lifecycle scripts.

Skips the root `pnpm:devPreinstall` hook and all approved dependency build scripts in the chained install.
"""#
    }
    flag --lockfile-only help="Refresh the lockfile without populating `node_modules`." {
        long_help #"""
Refresh the lockfile without populating `node_modules`.

Re-resolves the full graph (direct + transitive) and writes `aube-lock.yaml`, then skips the linker so `node_modules` is left untouched. Mirrors `npm update --package-lock-only`.
"""#
    }
    flag --no-optional help="Skip optionalDependencies."
    flag --no-save help="Refresh the lockfile without rewriting `package.json` ranges." {
        long_help #"""
Refresh the lockfile without rewriting `package.json` ranges.

Pair with `--latest` to refresh the lockfile to the newest version allowed by the unchanged manifest range. Without `--latest`, it still suppresses manifest range rewrites enabled by `updateRewritesSpecifier`. Mirrors `pnpm update --no-save`.
"""#
    }
    flag --pnpmfile help="Override the local pnpmfile location." conflicts=--ignore-pnpmfile {
        long_help #"""
Override the local pnpmfile location.

Mirrors pnpm's `--pnpmfile <path>`. Relative paths resolve against the project root; absolute paths are used as-is. Wins over `pnpmfilePath` from `pnpm-workspace.yaml`.
"""#
        arg <PATH>
    }
    use lockfile-args
    use network-args
    use virtual-store-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PACKAGES]..." help="Package(s) to update (all if empty)"
}
cmd version help="Bump the version in package.json (and optionally create a git commit + tag)" effect=write {
    flag --allow-same-version help="Allow setting the version to its current value without erroring."
    flag --ignore-scripts help="Skip `preversion` / `version` / `postversion` lifecycle scripts."
    flag --json help="Emit the result as JSON instead of `v<version>` text."
    flag "-m --message" help="Commit message template." {
        long_help #"""
Commit message template.

`%s` is replaced with the new version. Defaults to `v%s`.
"""#
        arg <MSG>
    }
    flag --no-commit-hooks help="Skip git pre-commit / commit-msg hooks (passes `--no-verify`)."
    flag --no-git-tag-version help="Don't create a git commit or tag." {
        long_help #"""
Don't create a git commit or tag.

By default `aube version` commits the manifest change and tags it `v<version>`.
"""#
    }
    flag --preid help="Prerelease identifier to use with the `pre*` keywords (e.g. `rc`)." {
        arg <ID>
    }
    flag --sign-git-tag help="GPG-sign the created tag (`git tag -s`)."
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[NEW_VERSION]" help="Bump keyword or an explicit version string." {
        long_help #"""
Bump keyword or an explicit version string.

Accepts `major`, `minor`, `patch`, `premajor`, `preminor`, `prepatch`, `prerelease`, `from-git`, or an explicit version. `from-git` reads the nearest reachable version-like Git tag. When omitted, prints the current version.
"""#
    }
}
cmd view help="Print package metadata from the registry" effect=read {
    alias info
    alias show
    alias v
    after_long_help #"""
Examples:

  $ aube view
  my-package@1.0.0 | MIT | deps: 0 | versions: 1

  $ aube view react
  react@18.3.1 | MIT | deps: 1 | versions: 2037
  React is a JavaScript library for building user interfaces.
  https://react.dev/

  keywords: react

  dist
  .tarball: https://registry.npmjs.org/react/-/react-18.3.1.tgz
  .shasum:  a0b2eb79...
  .integrity: sha512-...

  # A specific version
  $ aube view react@17.0.2

  # A single field
  $ aube view react version
  18.3.1

  $ aube view react dist.tarball
  https://registry.npmjs.org/react/-/react-18.3.1.tgz

  # All versions ever published
  $ aube view react versions --json

  # Raw JSON for the resolved version
  $ aube view react@next --json

"""#
    flag --json help="Print the full JSON of the selected version instead of the summary." {
        long_help #"""
Print the full JSON of the selected version instead of the summary.

Mutually exclusive with `field`.
"""#
    }
    use network-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[PACKAGE]" help="Package to view, optionally with a version or dist-tag." {
        long_help #"""
Package to view, optionally with a version or dist-tag.

Examples: `lodash`, `lodash@4.17.21`, `react@next`, `express@^4`.
"""#
    }
    arg "[FIELD]" help="Dotted path into the version metadata to print." {
        long_help #"""
Dotted path into the version metadata to print.

Examples: `version`, `dependencies`, `dist.tarball`, `maintainers.0.name`. When omitted, prints a formatted summary.
"""#
    }
}
cmd whoami help="Report the current registry user (not implemented — use `npm whoami`)" hide=#true effect=read {
    use fallback-args
    flag "-h --help" help="Print help" action=help builtin=#true
    arg "[ARGS]..." help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints." hide=#true double_dash=automatic
}
cmd why help="Print reverse dependency chains explaining why a package is installed" effect=read {
    alias w
    after_long_help #"""
Examples:

  $ aube why debug
  my-app@1.0.0 /home/user/project

  dependencies:
  express 4.19.2
  └── debug 2.6.9
  body-parser 1.20.2
  └── debug 2.6.9

  # Only follow chains starting at a devDependency
  $ aube why --dev typescript

  # Include each node's store path
  $ aube why --long debug

  # Tab-separated, one chain per line (pipe-friendly)
  $ aube why --parseable debug

  # JSON: an array of chain objects
  $ aube why --json debug

"""#
    flag "-D --dev" help="Only follow chains that start at a devDependency" conflicts=--prod
    flag "-P --prod --production" help="Only follow chains that start at a production (or optional) dependency" conflicts=--dev
    flag --json help="Output as JSON — an array of chain objects" conflicts=--parseable
    flag --long help="Append each node's `.aube/<dep_path>` store path to the tree output"
    flag --parseable help="Tab-separated output: one line per chain, `importer\\tdep_type\\tname@ver\\t...`"
    flag "-h --help" help="Print help" action=help builtin=#true
    arg <PACKAGE> help="Package name to search for (exact match against package names)"
}

// Route external usage consumers to the compiled completer used by the
// built-in scripts. The complete argv is preserved, including `-C`.
complete "script" run="aube __complete_word__ --candidates script --line={{ words | shell_join | shell_quote }}"

// Keep value completers in a shared fragment so `aube usage`, `aubr`, and
// `aubx` are generated from the same candidate protocol.
// Let external usage consumers ask the same compiled completers as the
// built-in scripts. shell_join preserves argv boundaries; shell_quote carries
// the reconstructed line through sh -c as one inert --line value.
complete "package" run="aube __complete_word__ --candidates package --line={{ words | shell_join | shell_quote }}"
complete "packages" run="aube __complete_word__ --candidates packages --line={{ words | shell_join | shell_quote }}"
complete "pkg" run="aube __complete_word__ --candidates pkg --line={{ words | shell_join | shell_quote }}"
complete "bin" run="aube __complete_word__ --candidates bin --line={{ words | shell_join | shell_quote }}"
complete "workspace" run="aube __complete_word__ --candidates workspace --line={{ words | shell_join | shell_quote }}"
complete "key" run="aube __complete_word__ --candidates key --line={{ words | shell_join | shell_quote }}"
complete "patch" run="aube __complete_word__ --candidates patch --line={{ words | shell_join | shell_quote }}"
complete "dir" type="dir"
complete "path" type="path"
