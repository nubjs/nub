    arg "[ARGS]…" help="Unused; captured so `aube <cmd> foo bar` parses instead of erroring on unexpected args before the fallback message prints" required=#false double_dash=automatic var=#true hide=#true
}
cmd why help="Print reverse dependency chains explaining why a package is installed" effect=read {
    alias w
    after_long_help #"""
Examples:

  $ aube why debug
  my-app@1.0.0 /home/user/project

  dependencies:
  express 4.19.2
  └── debug 2.6.9
  body-parser 1.20.2
  └── debug 2.6.9

  # Only follow chains starting at a devDependency
  $ aube why --dev typescript

  # Include each node's store path
  $ aube why --long debug

  # Tab-separated, one chain per line (pipe-friendly)
  $ aube why --parseable debug

  # JSON: an array of chain objects
  $ aube why --json debug

"""#
    flag "-D --dev" help="Only follow chains that start at a devDependency"
    flag "-P --prod --production" help="Only follow chains that start at a production (or optional) dependency"
    flag --json help="Output as JSON — an array of chain objects"
    flag --long help="Append each node's `.aube/<dep_path>` store path to the tree output"
    flag --parseable help="Tab-separated output: one line per chain, `importer\\tdep_type\\tname@ver\\t...`"
    arg <PACKAGE> help="Package name to search for (exact match against package names)"
}

// `aube run <TAB>` offers the scripts from the package.json nearest the
// shell's cwd.
//
// The command is fixed, so a `-C` on the line being completed is not
// forwarded and `aube -C packages/api run <TAB>` still offers the outer
// project's scripts. usage's only channel for the typed words is tera
// interpolation into a `sh -c` string, with no shell-quoting filter, so
// forwarding it would mean pasting user input into a shell command. The
// helper itself honors `-C` for direct invocation, ready for a safer
// channel upstream.
complete "script" run="aube run --complete" descriptions=#true

// Keep value completers in a shared fragment so `aube usage`, `aubr`, and
// `aubx` are generated from the same candidate protocol.
// Dynamic completion follows mise's custom-completer pattern: the usage
// spec delegates candidate production to a hidden, machine-oriented CLI mode.
//
// usage renders the current token into `sh -c`. Wrap it in single quotes and
// replace every embedded apostrophe with the POSIX close/escape/reopen form so
// arbitrary input remains one inert argument.
complete "package" run=#"aube completion _ --complete package --query='{{ words[CURRENT] | replace(from="'", to="'\\''") }}'"# descriptions=#true
complete "packages" run=#"aube completion _ --complete package --query='{{ words[CURRENT] | replace(from="'", to="'\\''") }}'"# descriptions=#true
complete "pkg" run=#"aube completion _ --complete package --query='{{ words[CURRENT] | replace(from="'", to="'\\''") }}'"# descriptions=#true
complete "bin" run="aube completion _ --complete bin" descriptions=#true
complete "workspace" run="aube completion _ --complete workspace" descriptions=#true
complete "key" run="aube completion _ --complete setting" descriptions=#true
complete "patch" run="aube completion _ --complete patch" descriptions=#true
complete "dir" type="dir"
complete "path" type="path"
