cmd diag subcommand_required=#true help="Diagnostic trace analysis (compare/analyze JSONL traces)" effect=read {
    cmd analyze help="Show critical path / starvation / per-pkg lifecycle from a saved trace" effect=read {
        arg <PATH> help="Trace JSONL"
    }
    cmd compare help="Diff two diag JSONL traces and surface per-operation regressions" effect=read {
        flag --min-delta-ms help="Minimum |Δsum_ms| to surface (default 50)" default="50" {
            arg <MIN_DELTA_MS>
        }
        flag --min-pct help="Minimum |%change| to surface (default 10)" default="10" {
            arg <MIN_PCT>
        }
        arg <A> help="Baseline trace"
        arg <B> help="Comparison trace"
    }
}
